# AgentEdu local model configuration.
# Copy this file to `.env`, then fill the key locally. Never commit `.env`.

# Required for a real model. Leave empty to use the deterministic offline model.
AGENTEDU_API_KEY=

# OpenAI-compatible endpoint and the only two enabled models.
AGENTEDU_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTEDU_MODEL=MiniMax-M3
AGENTEDU_MODEL_STRONG=deepseek-v4-pro

# Reliability and quota controls.
AGENTEDU_TIMEOUT=60
AGENTEDU_RETRIES=3
AGENTEDU_RPM=0
AGENTEDU_BUDGET_CALLS=0
AGENTEDU_CACHE=1

# Optional prices in CNY per million tokens, used only for local cost reporting.
AGENTEDU_PRICE_IN=0
AGENTEDU_PRICE_OUT=0
